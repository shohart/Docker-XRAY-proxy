# xray binary for exit-country probing (scripts/geo_probe.py): same version
# as the running xray, so every outbound the live config uses can be parsed.
ARG XRAY_IMAGE=ghcr.io/xtls/xray-core:latest
FROM ${XRAY_IMAGE} AS xray

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
WORKDIR /scripts

RUN pip install --no-cache-dir grpcio protobuf
COPY --from=xray /usr/local/bin/xray /usr/local/bin/xray

CMD ["python3", "/scripts/sticky_balancer.py"]
