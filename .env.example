# Xray subscription URL
XRAY_SUBSCRIPTION_URL=https://your-provider/config.json
XRAY_IMAGE=ghcr.io/xtls/xray-core:26.2.6

# Subscription update interval in minutes
SUB_UPDATE_INTERVAL_MIN=60

# LAN listening IP
LAN_LISTEN_IP=192.168.1.x

# Proxy ports
HTTP_PROXY_PORT=3128
SOCKS_PROXY_PORT=1080

# Local network subnet
LAN_CIDR=192.168.1.0/24

# Gateway mode (1 = enabled, 0 = disabled)
GATEWAY_MODE=1

# Transparent gateway local redirect port (dokodemo-door inbound)
GATEWAY_TPROXY_PORT=12345

# Trusted LAN DNS server for gateway clients (defaults to Technitium at 192.168.1.123)
GATEWAY_DNS_SERVER=192.168.1.123

# Redirect LAN DNS queries (port 53 UDP/TCP) to GATEWAY_DNS_SERVER (1 = enabled, 0 = disabled)
GATEWAY_REDIRECT_DNS=1

# Block QUIC (UDP 443) to force instant HTTP/2 TCP fallback over proxy (1 = enabled, 0 = disabled)
GATEWAY_BLOCK_QUIC=1

# Exclusions from proxying:
# - exact domains, comma-separated (example.com,api.example.com)
BYPASS_DOMAINS=
# - domain zones/suffixes, comma-separated (.local,.corp,example.org)
BYPASS_DOMAIN_ZONES=
# - explicit CIDRs, comma-separated (203.0.113.0/24,198.51.100.0/24)
BYPASS_IP_CIDRS=
# - wildcard IPv4 masks, trailing "*" only (203.0.*.*,198.51.100.*)
BYPASS_IP_MASKS=

# Multi-outbound balancing strategy:
# random | roundRobin | leastPing | leastLoad
# Use leastPing when OPENVPN_FALLBACK_ENABLED=1 so the higher-latency VPN is
# only chosen when xray nodes are down or slower than the VPN.
XRAY_BALANCER_STRATEGY=random

# OpenVPN backup tunnel (openvpn container).
# 1 = inject a SOCKS outbound (egressing through the OpenVPN tunnel) into the
#     balancer selector + observatory probe so it participates in rotation as a
#     fallback path; 0 = disabled.
OPENVPN_FALLBACK_ENABLED=0
# Host loopback port the openvpn container publishes its SOCKS proxy on.
OPENVPN_SOCKS_PORT=1081
# Outbound tag used for the VPN path (optional).
# OPENVPN_OUT_TAG=openvpn-out

# gRPC API for tunnelctl (manual override + status)
# 1 = enable API on 127.0.0.1:10085 (localhost only)
# 0 = disabled (default; tunnelctl won't work)
XRAY_API_ENABLED=0
XRAY_API_LISTEN=127.0.0.1
XRAY_API_PORT=10085

# Active probe settings used by observatory (keeps health checks running constantly)
# Probe URL: YouTube generate_204 as "real internet" indicator.
# Change to your preferred target, but keep it a lightweight 204 endpoint.
XRAY_PROBE_URL=https://www.youtube.com/generate_204
XRAY_PROBE_INTERVAL=20s
XRAY_PROBE_CONCURRENCY=1

# Optional leastLoad strategy settings
# XRAY_BALANCER_EXPECTED=3
# XRAY_BALANCER_MAX_RTT=1.5s
# XRAY_BALANCER_TOLERANCE=300
# XRAY_BALANCER_BASELINES=1.0,1.0,1.0
# XRAY_BALANCER_COSTS=0,0,0

# GhostLine VPN subscription (optional second provider)
# If set, nodes are merged with primary subscription into a single rotation.
# GHOSTLINE_SUBSCRIPTION_URL=https://api.ghostline.ru/api/v1/sub/...

# --- Smart Sticky Balancer Settings ---
# Daily rotation target hour and window (randomized around 6:00 AM)
STICKY_ROTATION_HOUR=6
STICKY_ROTATION_WINDOW_MIN=30

# Health check interval in seconds
STICKY_CHECK_INTERVAL_SEC=15

# Consecutive failed checks before declaring current node DEAD and failing over immediately
STICKY_FAIL_THRESHOLD=2

# Hysteresis threshold: candidate must be 50% faster (0.5) and at least 100ms faster
STICKY_HYSTERESIS_RATIO=0.5
STICKY_MIN_DIFF_MS=100

# Candidate must maintain substantial advantage for N consecutive ticks (anti-flapping)
STICKY_STABILITY_TICKS=3

# Threshold for severe degradation: switch if active RTT exceeds this (in ms)
STICKY_MAX_DEGRADED_RTT_MS=2500

# --- Exit-country probing (balancer daemon, isolated temporary xray) ---
# GEO_PROBE_ENABLED=1
# GEO_PROBE_INTERVAL_H=12
# GEO_PROBE_RETRY_MIN=30
# GEO_PROBE_CONCURRENCY=6
